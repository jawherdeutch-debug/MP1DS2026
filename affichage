<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consommation STEG DenDen</title>
  
  <!-- SheetJS pour lire le fichier Excel -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  
  <style>
    * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: #f8fafc; color: #1e293b; padding: 20px; margin: 0; }
    .container { max-width: 1200px; margin: 0 auto; background: #ffffff; padding: 25px; border-radius: 10px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
    h1 { color: #0f172a; margin-top: 0; font-size: 1.5rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 12px; }
    
    /* Barre d'outils */
    .toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; gap: 10px; flex-wrap: wrap; }
    .search-box { padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; width: 250px; font-size: 14px; outline: none; }
    .search-box:focus { border-color: #2563eb; ring: 2px #93c5fd; }
    .sheet-tabs { display: flex; gap: 8px; margin-bottom: 15px; border-bottom: 1px solid #e2e8f0; }
    .tab-btn { padding: 8px 16px; border: none; background: #f1f5f9; cursor: pointer; border-radius: 6px 6px 0 0; font-weight: 600; color: #64748b; }
    .tab-btn.active { background: #2563eb; color: #ffffff; }

    /* Conteneur de tableau */
    .table-container { overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 8px; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
    th { background-color: #f1f5f9; color: #334155; font-weight: 600; padding: 12px; border-bottom: 2px solid #e2e8f0; cursor: pointer; user-select: none; }
    th:hover { background-color: #e2e8f0; }
    td { padding: 10px 12px; border-bottom: 1px solid #f1f5f9; color: #475569; }
    tr:hover { background-color: #f8fafc; }
    tr:nth-child(even) { background-color: #fafafa; }

    /* Status et messages */
    .status-msg { padding: 15px; border-radius: 6px; margin-bottom: 15px; font-size: 14px; }
    .info { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
    .error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
  </style>
</head>
<body>

<div class="container">
  <h1>📊 Consommation STEG - DenDen</h1>
  
  <div id="status" class="status-msg info">Chargement du fichier Excel en cours...</div>
  
  <div id="sheet-tabs" class="sheet-tabs"></div>

  <div class="toolbar" id="toolbar" style="display: none;">
    <input type="text" id="search-input" class="search-box" placeholder="Rechercher une valeur..." onkeyup="filterTable()">
    <span id="row-count" style="font-size: 13px; color: #64748b;"></span>
  </div>

  <div class="table-container">
    <table id="excel-table">
      <!-- Le contenu du tableau sera généré ici -->
    </table>
  </div>
</div>

<script>
  // Nom exact de votre fichier Excel
  const EXCEL_FILE = 'Consommation-STEG-DenDen.xlsx';
  
  let globalWorkbook = null;
  let activeWorksheetData = [];

  // Charger le fichier dès l'ouverture de la page
  window.addEventListener('DOMContentLoaded', () => {
    fetch(EXCEL_FILE)
      .then(response => {
        if (!response.ok) throw new Error("Fichier introuvable ou erreur réseau");
        return response.arrayBuffer();
      })
      .then(buffer => {
        globalWorkbook = XLSX.read(buffer, { type: 'array' });
        document.getElementById('status').style.display = 'none';
        document.getElementById('toolbar').style.display = 'flex';
        renderSheetTabs();
        loadSheet(globalWorkbook.SheetNames[0]);
      })
      .catch(err => {
        const statusEl = document.getElementById('status');
        statusEl.className = 'status-msg error';
        statusEl.innerHTML = `<strong>Erreur :</strong> Impossible de charger le fichier <code>${EXCEL_FILE}</code>. Assurez-vous qu'il se trouve dans le même dossier que ce fichier HTML sur GitHub.`;
      });
  });

  // Générer les onglets si le fichier contient plusieurs feuilles
  function renderSheetTabs() {
    const tabsContainer = document.getElementById('sheet-tabs');
    tabsContainer.innerHTML = '';
    
    globalWorkbook.SheetNames.forEach((sheetName, index) => {
      const btn = document.createElement('button');
      btn.className = `tab-btn ${index === 0 ? 'active' : ''}`;
      btn.innerText = sheetName;
      btn.onclick = () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        loadSheet(sheetName);
      };
      tabsContainer.appendChild(btn);
    });
  }

  // Convertir et afficher la feuille sélectionnée
  function loadSheet(sheetName) {
    const worksheet = globalWorkbook.Sheets[sheetName];
    // Extraction des données brutes au format JSON
    activeWorksheetData = XLSX.utils.sheet_to_json(worksheet, { header: 1 });
    
    renderTable(activeWorksheetData);
  }

  // Rendu HTML du tableau
  function renderTable(data) {
    const table = document.getElementById('excel-table');
    table.innerHTML = '';

    if (!data || data.length === 0) {
      table.innerHTML = '<tr><td style="text-align:center; padding:20px;">La feuille est vide.</td></tr>';
      return;
    }

    // Entêtes (Première ligne)
    const thead = document.createElement('thead');
    const headerRow = document.createElement('tr');
    const headers = data[0];

    headers.forEach((headerText) => {
      const th = document.createElement('th');
      th.innerText = headerText !== undefined ? headerText : '';
      headerRow.appendChild(th);
    });
    thead.appendChild(headerRow);
    table.appendChild(thead);

    // Lignes de données
    const tbody = document.createElement('tbody');
    let visibleRows = 0;

    for (let i = 1; i < data.length; i++) {
      const rowData = data[i];
      if (rowData.length === 0) continue;

      const tr = document.createElement('tr');
      headers.forEach((_, colIndex) => {
        const td = document.createElement('td');
        const cellValue = rowData[colIndex];
        td.innerText = cellValue !== undefined ? cellValue : '';
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
      visibleRows++;
    }

    table.appendChild(tbody);
    document.getElementById('row-count').innerText = `${visibleRows} lignes affichées`;
  }

  // Filtre de recherche dynamique
  function filterTable() {
    const query = document.getElementById('search-input').value.toLowerCase();
    const rows = document.querySelectorAll('#excel-table tbody tr');
    let count = 0;

    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      if (text.includes(query)) {
        row.style.display = '';
        count++;
      } else {
        row.style.display = 'none';
      }
    });

    document.getElementById('row-count').innerText = `${count} lignes trouvées`;
  }
</script>

</body>
</html>
